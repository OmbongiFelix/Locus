# ── Database ─────────────────────────────────────────────────────────
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme

# Full DSN used by the Locus API (asyncpg)
DATABASE_URL=postgresql://app_user:changeme@localhost:5432/app_db

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0

# ── API behaviour ────────────────────────────────────────────────────
# Comma-separated list of static valid API keys (legacy). Leave empty for open access in dev.
API_KEYS=

# Max requests per API key per minute (sliding window)
RATE_LIMIT_PER_MINUTE=60

# Max requests per client IP per minute on authentication endpoints (register, login, resend)
AUTH_RATE_LIMIT_PER_MINUTE=10

# ST_DWithin fallback radius in metres (used when ST_Contains misses)
FALLBACK_RADIUS_M=5000

# Maximum number of points in a single batch request
MAX_BATCH_SIZE=50

# ── Connection pool ──────────────────────────────────────────────────
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30

# ── Cache TTLs (seconds) ────────────────────────────────────────────
CACHE_TTL_SECONDS=3600
CACHE_MISS_TTL_SECONDS=60

# ── Authentication & Security ────────────────────────────────────────
# Secret key used for signing JWT access tokens (generate with `openssl rand -hex 32`)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email verification token expiration in hours
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Maximum API requests allowed for unverified accounts before requiring email activation
MAX_UNVERIFIED_REQUESTS=5

# ── Email Provider Configuration ─────────────────────────────────────
# Provider mode: "console" (development), "mock" (testing), or "smtp" (production)
EMAIL_PROVIDER=console

#resend email provide
RESEND_API_KEY=trqwfdqjwhkbj


# SMTP configuration (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@locus.co.ke
SMTP_TLS=true

# Public application base URL (used to generate email verification links)
APP_URL=http://localhost:8000


